# Qloo hackathon key (sent by email). Without it the app runs on clearly labeled sample data.
QLOO_API_KEY=
# Hackathon keys only work against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# OpenRouter key for the model steps (finding references, rewriting lines, crowd-work openers).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Public URL of the deployed app (sent to OpenRouter as the referer).
APP_URL=http://localhost:3001
